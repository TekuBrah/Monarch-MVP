node_modules/
dist/
.DS_Store
*.local
.claude/*HANDOFF*.md

# Playwright (Gate 7). OUTPUT only — diffs, traces and the HTML report are
# regenerated on every run and are not worth reviewing in a diff.
#
# NOTE WHAT IS *NOT* IGNORED: `e2e/*-snapshots/`. The visual baselines are
# committed on purpose — they are the record of what the app looked like when
# the gate closed, and an unexplained change to one is a finding.
test-results/
playwright-report/

# Gate 22. The cross-build render comparison (Gate 16's method) builds the
# same tree twice into two out dirs so the two DS resolution paths can be
# rendered side by side. They are build OUTPUT, like dist/ above.
dist-package/
dist-default/

# Gate 50-B. The OCR language model, copied out of the pinned
# `@tesseract.js-data/eng` package by `scripts/sync-ocr-lang.mjs` before every
# dev server start and every build.
#
# GENERATED, NOT AUTHORED, WHICH IS WHY IT IS HERE and not committed: it is
# 2.82 MB of binary whose only source of truth is that dependency's pinned
# version, and a second copy in this repo's history would be a copy nothing
# keeps in step. It still DEPLOYS — `public/` is Vite's verbatim-copy directory
# and the sync runs from `prebuild:package`, which is Netlify's build command.
#
# The directory is named, not the file, so a second language model added later
# is covered without editing this.
public/ocr/
