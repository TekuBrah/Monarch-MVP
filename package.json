{
  "name": "monarch-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "tsc -b && node scripts/build-from-package.mjs",
    "preview": "vite preview",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:linkage": "node scripts/check-ds-linkage.mjs",
    "pretest:e2e": "npm run lint:linkage",
    "pretest:e2e:update": "npm run lint:linkage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@monarch/design-system": "github:TekuBrah/Monarch-Design-System#v1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^5.2.0"
  }
}
